# ---- Core ----
NODE_ENV=production
PORT=3000
# Random string; lets an external cron/uptime monitor call POST /api/internal/cleanup (header: x-cron-secret)
CRON_SECRET=change-me

# ---- Limits (single source of truth) ----
MAX_AUDIO_SECONDS=1500          # 25 minutes, exact boundary: 1500 accepted, >1500 rejected
RETURN_WINDOW_MINUTES=60
MAX_AUDIO_MB=200
MAX_IMAGE_MB=15
MAX_DOC_MB=2

# ---- Drivers (production requires firestore + r2) ----
DB_DRIVER=firestore             # firestore | memory (memory = local dev/tests only)
STORAGE_DRIVER=r2               # r2 | local (local = local dev/tests only)
LOCAL_DATA_DIR=.local-data

# ---- Firebase / Firestore ----
FIREBASE_PROJECT_ID=
# Paste the whole service-account JSON (or its base64) here on Render. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Cloudflare R2 (bucket must stay PRIVATE) ----
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Optional BCP-47 hints, comma separated (e.g. en-US). Empty = automatic detection.
GEMINI_LANGUAGE_CODES=

# ---- Media tools ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
PLAYBACK_GRACE_SECONDS=5

# ---- Rendering ----
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_FIT=contain              # contain (letterbox) | cover (crop)
RENDER_CRF=23
RENDER_TIMEOUT_MINUTES=30        # hard stop for one render

# ---- Background jobs (in-process, single web service) ----
JOB_HEARTBEAT_SECONDS=20
JOB_STALE_SECONDS=90
JOB_MAX_ATTEMPTS=2
CONCURRENCY_AUDIO_DURATION=3
CONCURRENCY_TRANSCRIPTION=2
CONCURRENCY_SYNC=2
CONCURRENCY_RENDER=1
CLEANUP_INTERVAL_SECONDS=300

# ---- Protecting /health on small instances ----
HEALTH_GATE=1                   # 1 = /health answered by a dedicated worker thread that owns the public port
FFMPEG_LOW_PRIORITY=1           # run render/transcode FFmpeg with `nice -n 19`
FFMPEG_HEAVY_CONCURRENCY=1      # max simultaneous render/transcode FFmpeg processes
RENDER_THREADS=1                # FFmpeg threads (default FFmpeg = one per host core, which starves a free instance)
RENDER_PRESET=ultrafast         # x264 preset; ultrafast = least CPU (default)
RENDER_TUNE=stillimage          # x264 tune for slideshow content (empty = none)
RENDER_BUDGET_MINUTES=25        # if a render is projected to take longer, the frame rate is stepped down and it restarts
TRANSCODE_TIMEOUT_MINUTES=15

# ---- Run heavy jobs on GitHub Actions instead of this instance (see GITHUB_ACTIONS.md) ----
REMOTE_JOB_TYPES=                       # e.g. videoRendering   or   videoRendering,audioTranscription   (empty = run everything here)
GH_DISPATCH_TOKEN=                      # fine-grained token, repo-only, permission "Actions: Read and write"
GH_REPO=                                # owner/repo
GH_WORKFLOW=render-job.yml
GH_REF=main                             # branch that contains the workflow
REMOTE_START_TIMEOUT_MINUTES=5          # runner must pick the job up within this time, else it runs here instead
REMOTE_STALE_MINUTES=3                  # a running remote job must show a heartbeat at least this often
REMOTE_FALLBACK_LOCAL=1                 # 1 = if GitHub can't be reached/started, render here instead of failing

# ---- Audio cut per batch (downloads on the Review/Export screens) ----
BATCH_AUDIO_FORMAT=mp3                  # default download format: mp3 | wav | m4a (user can also pick on screen)
